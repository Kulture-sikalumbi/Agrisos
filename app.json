{
  "expo": {
    "name": "Agrisos+",
    "slug": "AgrisosApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "agrisos",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F1F8E9"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cd214a31-1f4f-4bd4-a72a-45d07ec0f16e",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD",
      "enabled": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mrninja1.AgrisosApp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8F5E9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.mrninja1.AgrisosApp"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Agrisos+ to access your camera to scan cassava leaves."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Agrisos+ to access your photos to analyze cassava leaves."
        }
      ],
      [
        "react-native-fast-tflite",
        {
          "enableAndroidGpuLibraries": true
        }
      ],
      "expo-updates"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "cd214a31-1f4f-4bd4-a72a-45d07ec0f16e"
      }
    },
    "owner": "mr-ninja1"
  }
}
